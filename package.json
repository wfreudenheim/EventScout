{
  "name": "event-scout",
  "version": "0.1.0",
  "description": "NYC cultural event discovery and calendar system",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "scout": "tsx src/cli/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "serve": "cd ui && npm run sync-data && npx vite --host"
  },
  "bin": {
    "scout": "./dist/cli/index.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
